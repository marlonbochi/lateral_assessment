# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="CMS Content Sync"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (PostgreSQL, provided by docker-compose)
# The test suite uses the separate cms_sync_test database (see .env.testing).
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cms_sync
DB_USERNAME=cms
DB_PASSWORD=change-me
DB_FORWARD_PORT=54329

# Stateless API: no sessions are used.
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# CMS webhook (HTTP Basic). Use long random values; never commit real ones.
# Empty values make the webhook reject every request (fail closed).
# ---------------------------------------------------------------------------
CMS_WEBHOOK_USERNAME=cms
CMS_WEBHOOK_PASSWORD=change-me
CMS_WEBHOOK_MAX_BODY_BYTES=1048576
CMS_WEBHOOK_RATE_LIMIT=300

# Queue used for batch processing. Must stay on the same PostgreSQL database.
CMS_QUEUE_CONNECTION=database
CMS_QUEUE_NAME=cms-events

# Processed batches are pruned after this many days (failed ones are kept).
CMS_BATCH_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Consumer API (Sanctum bearer tokens)
# ---------------------------------------------------------------------------
API_RATE_LIMIT=120
SANCTUM_TOKEN_EXPIRATION_MINUTES=129600
SANCTUM_TOKEN_PREFIX=cms_
LOG_CMS_STREAM=php://stderr
LOG_CMS_LEVEL=info
