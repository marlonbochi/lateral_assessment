# Environment and secrets
.env
.env.backup
.env.production
.env.*.local
auth.json

# Dependencies and build output
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail

# Test and tooling caches
.phpunit.cache
.phpunit.result.cache
/coverage
.php-cs-fixer.cache

# IDE and OS
.idea
.vscode
.fleet
.zed
.DS_Store
Thumbs.db

# Local agent settings (may contain machine-specific permissions)
.claude/settings.local.json

# Docker volumes
/docker/data

# Laravel
*.log
.env.production
.phpactor.json
/.phpunit.cache
/public/fonts-manifest.dev.json
_ide_helper.php
Homestead.json
Homestead.yaml
/database/*.sqlite

# Local performance results
/storage/logs/performance.json

# Laravel runtime storage (generated; never commit: caches can capture environment values)
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/storage/app/*
!/storage/**/.gitkeep
